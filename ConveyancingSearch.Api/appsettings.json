{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Source": {
    "ParallelDownloads": 4,
    "MaxPages": 512,
    "RequestTimeoutSeconds": 20
  },
  "Search": {
    "FreshnessHours": 24,
    "RefreshTimeoutSeconds": 300
  }
}
