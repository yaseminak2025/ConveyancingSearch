# .NET
bin/
obj/
*.user
.vs/
*.Backup.tmp

# Publish profiles record a machine-specific local deploy target
# (e.g. PublishUrl pointing at this developer's own folder) and a
# per-run publish History — not something another machine can use.
**/Properties/PublishProfiles/

# Node (ConveyancingSearch.Ui and any other frontend)
node_modules/
dist/
coverage/
# Generated by `npm run build` in ConveyancingSearch.Ui
ConveyancingSearch.Api/wwwroot/
*.tsbuildinfo

# Playwright output (npm run test:browser)
test-results/
playwright-report/
blob-report/

# Publish output (SETUP.md step 6)
artifacts/

# Environment / secrets
.env
.env.local
appsettings.*.local.json

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code: settings.local.json holds this machine's own tool
# permissions, not something to impose on other contributors. A shared
# .claude/settings.json (if one is ever added) is still tracked.
.claude/settings.local.json